{
  "name": "@codebaz/nextdoctor-agent",
  "version": "0.1.1-beta.1",
  "type": "module",
  "description": "NextDoctor agent for OpenTelemetry tracing and performance monitoring",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js"
    },
    "./optimization": {
      "types": "./dist/optimization.d.ts",
      "import": "./dist/optimization.js"
    },
    "./system-monitor": {
      "types": "./dist/system-monitor.d.ts",
      "import": "./dist/system-monitor.js"
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc --build",
    "test": "vitest",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.72.0",
    "@opentelemetry/core": "^2.6.1",
    "@opentelemetry/exporter-otlp-http": "^0.26.0",
    "@opentelemetry/instrumentation": "^0.214.0",
    "@opentelemetry/instrumentation-http": "^0.214.0",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@opentelemetry/sdk-trace-base": "^2.6.1",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "@vercel/otel": "^2.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^1.5.0"
  },
  "peerDependencies": {
    "next": ">=14.0.0"
  }
}