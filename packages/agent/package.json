{
  "name": "@codebaz/nextdoctor-agent",
  "version": "0.1.2-beta.2",
  "type": "module",
  "bin": {
    "nextdoctor-agent": "./dist/cli/index.js"
  },
  "description": "NextDoctor agent for OpenTelemetry tracing and performance monitoring",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js"
    },
    "./optimization": {
      "types": "./dist/optimization.d.ts",
      "import": "./dist/optimization.js"
    },
    "./system-monitor": {
      "types": "./dist/system-monitor.d.ts",
      "import": "./dist/system-monitor.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc --build",
    "test": "vitest",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.6.1",
    "@opentelemetry/exporter-otlp-http": "^0.26.0",
    "@opentelemetry/instrumentation": "^0.214.0",
    "@opentelemetry/instrumentation-connect": "^0.57.0",
    "@opentelemetry/instrumentation-dns": "^0.57.0",
    "@opentelemetry/instrumentation-http": "^0.214.0",
    "@opentelemetry/instrumentation-mysql2": "^0.60.0",
    "@opentelemetry/instrumentation-net": "^0.58.0",
    "@opentelemetry/instrumentation-pg": "^0.66.0",
    "@opentelemetry/sdk-trace-base": "^2.6.1",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "@prisma/instrumentation": "^7.6.0",
    "@vercel/otel": "^2.1.1",
    "otel-instrumentation-postgres": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.10",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "enquirer": "^2.4.1",
    "eslint": "^9.0.0",
    "next": "16.1.6",
    "react": "^19.2.4",
    "react-scan": "^0.5.3",
    "ts-morph": "^27.0.2",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "peerDependencies": {
    "next": ">=14.0.0"
  }
}